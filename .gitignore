# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state, not tracked
groups/*

# Composer-managed CLAUDE.md artifacts (regenerated every spawn) and
# per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md
**/.claude-shared.md
**/.claude-fragments/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs

# Personal Claude Code / Tessl / agent state — not for trunk
.agents/
.tessl/
.github/skills/
.claude/skills/tessl__*

# container/skills — track only trunk skills + locally-added trunk-eligible
# ones. Personal/v1-migrated workflow skills (ad-analyzer, agency-prospector,
# brainstorming, etc.) stay local — they're per-install workflow content,
# not nanoclaw source.
container/skills/*
!container/skills/agent-browser/
!container/skills/frontend-engineer/
!container/skills/gh-issue/
!container/skills/self-customize/
!container/skills/slack-formatting/
!container/skills/vercel-cli/
!container/skills/welcome/
!container/skills/agent-mesh/
!container/skills/social-monitor/

# One-off / local scripts
scripts/.granola-auth-state.json
scripts/migrate-finsi-wire.ts
scripts/show-wiring.ts
